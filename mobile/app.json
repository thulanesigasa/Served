{
  "expo": {
    "name": "Served",
    "slug": "served",
    "scheme": "served",
    "version": "1.0.2",
    "runtimeVersion": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "za.co.tsindustries.served",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "za.co.tsindustries.served",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#251929"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Served to scan your restaurant's guest QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 172,
          "resizeMode": "contain",
          "backgroundColor": "#251929"
        }
      ]
    ],
    "platforms": [
      "android",
      "ios"
    ]
  }
}
